# Copy to android/key.properties (git-ignored) and fill in. Create the upload
# keystore once with:
#   keytool -genkey -v -keystore ~/citycalls-upload.jks -keyalg RSA -keysize 2048 -validity 10000 -alias upload
# Keep the .jks and its passwords somewhere safe — losing them means you can
# no longer ship updates under the same Play Store listing.
storePassword=<keystore password>
keyPassword=<key password>
keyAlias=upload
storeFile=C:/path/to/citycalls-upload.jks
